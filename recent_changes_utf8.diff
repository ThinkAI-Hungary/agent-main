+        </div>
+
+        <div className="cpv-footer">
+          <button
+            className="cpv-btn cpv-btn-start"
+            onClick={handleSchedule}
+            disabled={submitting}
+            style={{ background: '#8b5cf6', color: '#fff' }}
+          >
+            {submitting ? 'Ment├ęs...' : 'Ment├ęs'}
+          </button>
+          <button className="cpv-btn cpv-btn-close" onClick={onClose}>
+            M├ęgse
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
