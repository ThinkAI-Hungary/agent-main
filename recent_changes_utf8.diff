+
+function ScheduleModal({ campaign, onClose, onScheduled }: ScheduleModalProps) {
+  const [dateStr, setDateStr] = useState('');
+  const [timeStr, setTimeStr] = useState('');
+  const [errorMsg, setErrorMsg] = useState('');
+  const [submitting, setSubmitting] = useState(false);
+
+  useEffect(() => {
+    const tomorrow = new Date();
+    tomorrow.setDate(tomorrow.getDate() + 1);
+    const yyyy = tomorrow.getFullYear();
+    const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
+    const dd = String(tomorrow.getDate()).padStart(2, '0');
+    setDateStr(`${yyyy}-${mm}-${dd}`);
+    setTimeStr('09:00');
+  }, []);
+
+  const handleQuickSelect = (hoursFromNow: number, targetTime?: string) => {
+    const dt = new Date();
+    dt.setTime(dt.getTime() + hoursFromNow * 60 * 60 * 1000);
+    const yyyy = dt.getFullYear();
+    const mm = String(dt.getMonth() + 1).padStart(2, '0');
+    const dd = String(dt.getDate()).padStart(2, '0');
+    setDateStr(`${yyyy}-${mm}-${dd}`);
+    if (targetTime) {
+      setTimeStr(targetTime);
+    } else {
+      const hh = String(dt.getHours()).padStart(2, '0');
+      const min = String(dt.getMinutes()).padStart(2, '0');
+      setTimeStr(`${hh}:${min}`);
+    }
+    setErrorMsg('');
+  };
+
+  const handleSchedule = async () => {
+    if (!dateStr || !timeStr) {
+      setErrorMsg('K├ęrj├╝k, v├ílassz d├ítumot ├ęs id┼Ĺpontot!');
+      return;
+    }
+
+    const localDateTime = new Date(`${dateStr}T${timeStr}`);
+    if (isNaN(localDateTime.getTime())) {
+      setErrorMsg('├ërv├ęnytelen d├ítum vagy id┼Ĺpont!');
+      return;
+    }
+
+    if (localDateTime <= new Date()) {
+      setErrorMsg('A tervezett id┼Ĺpontnak a j├Âv┼Ĺben kell lennie!');
+      return;
+    }
+
+    setErrorMsg('');
+    setSubmitting(true);
+
+    try {
+      const scheduledAt = localDateTime.toISOString();
+      const res = await authFetch(`/admin/api/campaigns/${campaign.id}/schedule`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ scheduled_at: scheduledAt }),
+      });
+
+      if (res.ok) {
+        showToast('Kamp├íny sikeresen ├╝temezve!');
+        onScheduled();
+        onClose();
+      } else {
+        const errData = await res.json().catch(() => ({}));
+        showToast(errData.detail || 'Sikertelen ├╝temez├ęs', 'error');
+      }
+    } catch {
+      showToast('H├íl├│zati hiba az ├╝temez├ęs sor├ín', 'error');
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  return (
+    <div className="cpv-overlay" onClick={onClose}>
