+          color: var(--text);
+          font-size: 13px;
+          font-family: inherit;
+          outline: none;
+          box-sizing: border-box;
+          transition: border-color 0.15s;
+        }
+        .sched-input:focus {
+          border-color: #8b5cf6;
+        }
+      `}</style>
+      <div className="cpv-card" onClick={e => e.stopPropagation()} style={{ width: 440 }}>
+        <div className="cpv-header">
+          <button className="cpv-close" onClick={onClose}>ÔťĽ</button>
+          <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 8 }}>
+            <span className="cpv-badge cpv-badge-status" style={{ background: 'rgba(139,92,246,0.1)', color: '#8b5cf6' }}>
+              Kamp├íny ├╝temez├ęse
+            </span>
+          </div>
+          <h2 className="cpv-name">{campaign.name}</h2>
+        </div>
+
+        <div className="cpv-body" style={{ padding: '24px 28px' }}>
+          <div style={{ marginBottom: 20 }}>
+            <label style={{ display: 'block', fontSize: 11, fontWeight: 700, color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 10 }}>
+              Gyors v├ílaszt├ís
+            </label>
+            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
+              <button type="button" className="sched-quick-btn" onClick={() => handleQuickSelect(24, '09:00')}>
+                Holnap reggel (09:00)
+              </button>
+              <button type="button" className="sched-quick-btn" onClick={() => handleQuickSelect(24, '14:00')}>
+                Holnap d├ęlut├ín (14:00)
+              </button>
+              <button type="button" className="sched-quick-btn" onClick={() => handleQuickSelect(48, '10:00')}>
+                2 nap m├║lva (10:00)
+              </button>
+              <button type="button" className="sched-quick-btn" onClick={() => handleQuickSelect(168, '09:00')}>
+                1 h├ęt m├║lva (09:00)
+              </button>
+            </div>
+          </div>
+
+          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16, marginBottom: 16 }}>
+            <div>
+              <label style={{ display: 'block', fontSize: 11, fontWeight: 700, color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 8 }}>
+                D├ítum
+              </label>
+              <input
+                type="date"
+                className="sched-input"
+                value={dateStr}
+                onChange={e => { setDateStr(e.target.value); setErrorMsg(''); }}
+              />
+            </div>
+            <div>
+              <label style={{ display: 'block', fontSize: 11, fontWeight: 700, color: 'var(--text-muted)', textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 8 }}>
+                Id┼Ĺpont
+              </label>
+              <input
+                type="time"
+                className="sched-input"
+                value={timeStr}
+                onChange={e => { setTimeStr(e.target.value); setErrorMsg(''); }}
+              />
+            </div>
+          </div>
+
+          {errorMsg && (
+            <div style={{ color: '#ef4444', fontSize: 13, fontWeight: 600, marginTop: 10 }}>
+              {errorMsg}
+            </div>
